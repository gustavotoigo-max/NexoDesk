<ui:NxWindow x:Class="NexoDesk.Agent.Views.MainWindow"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:ui="clr-namespace:NexoDesk.Ui.Controls;assembly=NexoDesk.Ui"
             xmlns:local="clr-namespace:NexoDesk.Agent"
             mc:Ignorable="d"
             d:DataContext="{d:DesignInstance Type=local:AgentController}"
             Title="NexoDesk Agent"
             Tagline="Acesso remoto a este computador"
             Width="860" Height="760" MinWidth="680" MinHeight="520"
             WindowStartupLocation="CenterScreen">

    <ui:NxWindow.TitleBarContent>
        <ui:NxBadge Kind="{Binding StateKind}" ShowDot="True" Content="{Binding StateText}" Margin="0,0,4,0" />
    </ui:NxWindow.TitleBarContent>

    <ui:NxWindow.FooterContent>
        <TextBlock>
            <Run Text="Nexotool · NexoDesk Agent" /> <Run Text="{Binding VersionText, Mode=OneWay}" />
        </TextBlock>
    </ui:NxWindow.FooterContent>

    <ui:NxWindow.FooterRightContent>
        <StackPanel Orientation="Horizontal">
            <Button Style="{DynamicResource Nx.FooterLink}" Content="Abrir configuração" Command="{Binding OpenConfigCommand}" />
            <TextBlock Text="·" Margin="10,0" Foreground="{DynamicResource Nx.OnNavyMuted}" />
            <Button Style="{DynamicResource Nx.FooterLink}" Content="Pasta de logs" Command="{Binding OpenLogsCommand}" />
        </StackPanel>
    </ui:NxWindow.FooterRightContent>

    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
        <StackPanel Margin="28,22,28,24">

            <Grid Margin="0,0,0,18">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <StackPanel>
                    <TextBlock Style="{DynamicResource Nx.PageTitle}" Text="Acesso remoto" />
                    <TextBlock Style="{DynamicResource Nx.PageSubtitle}"
                               Text="Somente administradores autorizados, pela rede Tailscale. Fechar esta janela mantém o Agent na área de notificação." />
                </StackPanel>
                <Button Grid.Column="1" Style="{DynamicResource Nx.Button}" Content="Reiniciar Agent" Command="{Binding RestartCommand}" VerticalAlignment="Center" Margin="16,0,0,0" />
            </Grid>

            <!-- Problema de configuração -->
            <Border Margin="0,0,0,16">
                <Border.Style>
                    <Style TargetType="Border" BasedOn="{StaticResource Nx.Alert.Danger}">
                        <Setter Property="Visibility" Value="Collapsed" />
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding HasProblem}" Value="True">
                                <Setter Property="Visibility" Value="Visible" />
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </Border.Style>
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <TextBlock FontFamily="{DynamicResource Nx.Icons}" Text="&#xEA39;" FontSize="16" Foreground="{DynamicResource Nx.Danger}" Margin="0,1,12,0" VerticalAlignment="Top" />
                    <StackPanel Grid.Column="1">
                        <TextBlock Style="{DynamicResource Nx.AlertTitle}" Text="O Agent não está aceitando conexões" />
                        <TextBlock Style="{DynamicResource Nx.AlertText}" Text="{Binding Problem}" />
                        <TextBlock Style="{DynamicResource Nx.AlertText}" Margin="0,6,0,0">
                            <Run Text="Arquivo:" /> <Run Text="{Binding ConfigPath, Mode=OneWay}" FontFamily="{DynamicResource Nx.Mono}" />
                        </TextBlock>
                    </StackPanel>
                    <Button Grid.Column="2" Style="{DynamicResource Nx.Button.Primary.Small}" Content="Tentar de novo" Command="{Binding RestartCommand}"
                            VerticalAlignment="Center" Margin="12,0,0,0" />
                </Grid>
            </Border>

            <!-- Sessão atual -->
            <Border Style="{DynamicResource Nx.Card}" Margin="0,0,0,16">
                <StackPanel>
                    <TextBlock Style="{DynamicResource Nx.SectionLabel}" Text="SESSÃO ATUAL" />
                    <Grid>
                        <Grid.Style>
                            <Style TargetType="Grid">
                                <Setter Property="Visibility" Value="Collapsed" />
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding HasSession}" Value="True">
                                        <Setter Property="Visibility" Value="Visible" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Grid.Style>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <Border Width="40" Height="40" CornerRadius="20" Background="{DynamicResource Nx.WarningSoft}" Margin="0,0,14,0">
                            <TextBlock FontFamily="{DynamicResource Nx.Icons}" Text="&#xE7F4;" FontSize="16" Foreground="{DynamicResource Nx.Warning}"
                                       HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <StackPanel Grid.Column="1" VerticalAlignment="Center">
                            <TextBlock FontWeight="SemiBold">
                                <Run Text="{Binding SessionAdmin, Mode=OneWay}" /> <Run Text="está acessando este computador" />
                            </TextBlock>
                            <TextBlock Style="{DynamicResource Nx.Hint}" Margin="0,2,0,0" Text="{Binding SessionDetail}" />
                        </StackPanel>
                        <Button Grid.Column="2" Style="{DynamicResource Nx.Button.DangerSolid}" Content="Encerrar acesso" Command="{Binding EndSessionCommand}" VerticalAlignment="Center" />
                    </Grid>
                    <TextBlock Text="Nenhum acesso remoto ativo.">
                        <TextBlock.Style>
                            <Style TargetType="TextBlock" BasedOn="{StaticResource Nx.Muted}">
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding HasSession}" Value="True">
                                        <Setter Property="Visibility" Value="Collapsed" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </TextBlock.Style>
                    </TextBlock>
                </StackPanel>
            </Border>

            <!-- Este computador -->
            <Border Style="{DynamicResource Nx.Card}" Margin="0,0,0,16">
                <StackPanel>
                    <TextBlock Style="{DynamicResource Nx.SectionLabel}" Text="ESTE COMPUTADOR" />
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="150" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="34" />
                            <RowDefinition Height="34" />
                            <RowDefinition Height="34" />
                            <RowDefinition Height="34" />
                        </Grid.RowDefinitions>
                        <TextBlock Style="{DynamicResource Nx.FieldLabel}" Text="Nome" />
                        <TextBlock Grid.Column="1" VerticalAlignment="Center" Text="{Binding MachineText}" />
                        <TextBlock Grid.Row="1" Style="{DynamicResource Nx.FieldLabel}" Text="Escutando em" />
                        <TextBlock Grid.Row="1" Grid.Column="1" VerticalAlignment="Center" Text="{Binding ListenText}" FontFamily="{DynamicResource Nx.Mono}" FontSize="12" />
                        <TextBlock Grid.Row="2" Style="{DynamicResource Nx.FieldLabel}" Text="Certificado" />
                        <TextBlock Grid.Row="2" Grid.Column="1" VerticalAlignment="Center" Text="{Binding CertificateText}" FontFamily="{DynamicResource Nx.Mono}" FontSize="12" />
                        <TextBlock Grid.Row="3" Style="{DynamicResource Nx.FieldLabel}" Text="Acesso não assistido" />
                        <ui:NxBadge Grid.Row="3" Grid.Column="1" Kind="{Binding UnattendedKind}" Content="{Binding UnattendedText}" />
                    </Grid>
                    <TextBlock Style="{DynamicResource Nx.Hint}"
                               Text="Para mudar estas opções, edite a configuração como administrador do Windows e clique em Reiniciar Agent." />
                </StackPanel>
            </Border>

            <!-- Administradores autorizados -->
            <Border Style="{DynamicResource Nx.Card}" Margin="0,0,0,16">
                <StackPanel>
                    <TextBlock Style="{DynamicResource Nx.SectionLabel}" Text="ADMINISTRADORES AUTORIZADOS" />
                    <Border CornerRadius="10" BorderBrush="{DynamicResource Nx.Border}" BorderThickness="1">
                        <DataGrid Style="{DynamicResource Nx.Table}" ItemsSource="{Binding AllowedClients}" BorderThickness="0" MaxHeight="220">
                            <DataGrid.Columns>
                                <DataGridTextColumn Header="Nome" Binding="{Binding Name}" Width="*" />
                                <DataGridTextColumn Header="Certificado (SHA-256)" Binding="{Binding Fingerprint}" Width="220">
                                    <DataGridTextColumn.ElementStyle>
                                        <Style TargetType="TextBlock" BasedOn="{StaticResource Nx.MonoText}" />
                                    </DataGridTextColumn.ElementStyle>
                                </DataGridTextColumn>
                            </DataGrid.Columns>
                        </DataGrid>
                    </Border>
                </StackPanel>
            </Border>

            <!-- Registro -->
            <Border Style="{DynamicResource Nx.Card}">
                <StackPanel>
                    <Grid Margin="0,0,0,8">
                        <TextBlock Style="{DynamicResource Nx.SectionLabel}" Text="REGISTRO" Margin="0" VerticalAlignment="Center" />
                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                            <Button Style="{DynamicResource Nx.Link}" Content="Pasta de logs" Command="{Binding OpenLogsCommand}" />
                            <TextBlock Style="{DynamicResource Nx.Sep}" />
                            <Button Style="{DynamicResource Nx.Link}" Content="Limpar" Command="{Binding ClearLogCommand}" />
                        </StackPanel>
                    </Grid>
                    <Border Style="{DynamicResource Nx.Log}" Height="170">
                        <ScrollViewer x:Name="LogScroll" VerticalScrollBarVisibility="Auto">
                            <ItemsControl ItemsSource="{Binding Log}" ItemTemplate="{DynamicResource Nx.LogLineTemplate}" />
                        </ScrollViewer>
                    </Border>
                    <TextBlock Style="{DynamicResource Nx.Hint}" Text="O registro guarda horários, identidades e resultados. Nunca grava imagens da tela nem teclas digitadas." />
                </StackPanel>
            </Border>
        </StackPanel>
    </ScrollViewer>
</ui:NxWindow>
