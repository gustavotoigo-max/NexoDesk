<ui:NxWindow x:Class="NexoDesk.App.Views.AddComputerWindow"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:ui="clr-namespace:NexoDesk.Ui.Controls;assembly=NexoDesk.Ui"
             xmlns:vm="clr-namespace:NexoDesk.App.ViewModels"
             mc:Ignorable="d"
             d:DataContext="{d:DesignInstance Type=vm:AddComputerViewModel}"
             Title="Adicionar PC REMOTO"
             Width="620" SizeToContent="Height"
             ResizeMode="NoResize"
             CanMinimize="False" CanMaximize="False" ShowFooter="False"
             ShowInTaskbar="False"
             WindowStartupLocation="CenterOwner">

    <StackPanel Margin="28,22,28,22">
        <!-- Passos -->
        <Border Style="{DynamicResource Nx.Alert}" Margin="0,0,0,18">
            <StackPanel>
                <TextBlock Style="{DynamicResource Nx.AlertTitle}" Text="No PC REMOTO" />
                <TextBlock Style="{DynamicResource Nx.AlertText}"
                           Text="1. Abra o NexoDesk (modo PC REMOTO).  2. Clique em Gerar código de pareamento.  3. Digite aqui o endereço e o código que aparecem lá." />
            </StackPanel>
        </Border>

        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="150" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <TextBlock Style="{DynamicResource Nx.FieldLabel}" Text="Endereço" VerticalAlignment="Top" Margin="0,9,0,0" />
            <StackPanel Grid.Column="1" Margin="0,0,0,14">
                <TextBox x:Name="AddressBox" Style="{DynamicResource Nx.Input.Mono}" Text="{Binding Address, UpdateSourceTrigger=PropertyChanged}" />
                <TextBlock Style="{DynamicResource Nx.Hint}" Text="Como aparece no PC REMOTO, em Endereço deste PC REMOTO. Ex.: pc-oficina.tail1234.ts.net ou 100.101.102.103" />
            </StackPanel>

            <TextBlock Grid.Row="1" Style="{DynamicResource Nx.FieldLabel}" Text="Código" VerticalAlignment="Top" Margin="0,9,0,0" />
            <StackPanel Grid.Row="1" Grid.Column="1" Margin="0,0,0,14">
                <TextBox Style="{DynamicResource Nx.Input.Mono}" Text="{Binding Code, UpdateSourceTrigger=PropertyChanged}" CharacterCasing="Upper" MaxLength="16" FontSize="15" />
                <TextBlock Style="{DynamicResource Nx.Hint}" Text="12 letras e números, como K7QM-4XRT-9BWN. Vale 10 minutos e uma única vez." />
            </StackPanel>

            <TextBlock Grid.Row="2" Style="{DynamicResource Nx.FieldLabel}" Text="Nome (opcional)" VerticalAlignment="Top" Margin="0,9,0,0" />
            <StackPanel Grid.Row="2" Grid.Column="1">
                <TextBox Style="{DynamicResource Nx.Input}" Text="{Binding Name, UpdateSourceTrigger=PropertyChanged}" MaxLength="64" />
                <TextBlock Style="{DynamicResource Nx.Hint}" Text="Em branco, usa o nome que o PC REMOTO informar." />
            </StackPanel>
        </Grid>

        <ProgressBar Margin="150,18,0,0" IsIndeterminate="True">
            <ProgressBar.Style>
                <Style TargetType="ProgressBar" BasedOn="{StaticResource Nx.Progress}">
                    <Setter Property="Visibility" Value="Collapsed" />
                    <Style.Triggers>
                        <DataTrigger Binding="{Binding IsBusy}" Value="True">
                            <Setter Property="Visibility" Value="Visible" />
                        </DataTrigger>
                    </Style.Triggers>
                </Style>
            </ProgressBar.Style>
        </ProgressBar>
        <TextBlock Style="{DynamicResource Nx.ProgressStatus}" Margin="150,10,0,0" Text="{Binding StatusText}" Tag="{Binding StatusTag}" />

        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,20,0,0">
            <Button Style="{DynamicResource Nx.Button}" Content="{Binding CancelText}" Command="{Binding CancelCommand}" IsCancel="True" Margin="0,0,10,0" />
            <Button Style="{DynamicResource Nx.Button.Primary}" Content="Parear" Command="{Binding PairCommand}" IsDefault="True" />
        </StackPanel>
    </StackPanel>
</ui:NxWindow>
