<ui:NxWindow x:Class="NexoDesk.App.Views.SettingsWindow"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:ui="clr-namespace:NexoDesk.Ui.Controls;assembly=NexoDesk.Ui"
             xmlns:vm="clr-namespace:NexoDesk.App.ViewModels"
             mc:Ignorable="d"
             d:DataContext="{d:DesignInstance Type=vm:SettingsViewModel}"
             Title="Configurações"
             Width="640" SizeToContent="Height"
             ResizeMode="NoResize"
             CanMinimize="False" CanMaximize="False" ShowFooter="False"
             ShowInTaskbar="False"
             WindowStartupLocation="CenterOwner">

    <StackPanel Margin="28,22,28,22">

        <!-- Este computador -->
        <Border Style="{DynamicResource Nx.Card}" Margin="0,0,0,14">
            <StackPanel>
                <TextBlock Style="{DynamicResource Nx.SectionLabel}" Text="ESTE COMPUTADOR" />
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="150" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <TextBlock Style="{DynamicResource Nx.FieldLabel}" Text="Nome" />
                    <TextBox Grid.Column="1" Style="{DynamicResource Nx.Input}" Text="{Binding DeviceName, UpdateSourceTrigger=PropertyChanged}" MaxLength="64" />
                    <Button Grid.Column="2" Style="{DynamicResource Nx.Button.Small}" Content="Salvar" Command="{Binding SaveNameCommand}" Margin="10,0,0,0" />
                </Grid>
                <TextBlock Style="{DynamicResource Nx.Hint}" Margin="150,6,0,0" Text="Novos pareamentos usam este nome. Os já feitos mantêm o nome da época." />
            </StackPanel>
        </Border>

        <!-- Modo -->
        <Border Style="{DynamicResource Nx.Card}" Margin="0,0,0,14">
            <StackPanel>
                <TextBlock Style="{DynamicResource Nx.SectionLabel}" Text="MODO" />
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <TextBlock Text="{Binding RoleText}" FontWeight="SemiBold" VerticalAlignment="Center" TextWrapping="Wrap" />
                    <Button Grid.Column="1" Style="{DynamicResource Nx.Button}" Content="{Binding SwitchRoleText}" Click="OnSwitchRole" Margin="12,0,0,0" />
                </Grid>
            </StackPanel>
        </Border>

        <!-- Aparência -->
        <Border Style="{DynamicResource Nx.Card}" Margin="0,0,0,14">
            <StackPanel>
                <TextBlock Style="{DynamicResource Nx.SectionLabel}" Text="APARÊNCIA" />
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="150" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <TextBlock Style="{DynamicResource Nx.FieldLabel}" Text="Tema" />
                    <Border Grid.Column="1" Style="{DynamicResource Nx.Segmented}">
                        <StackPanel Orientation="Horizontal">
                            <RadioButton Style="{DynamicResource Nx.SegmentedItem}" GroupName="Theme" Content="Automático"
                                         IsChecked="{Binding ThemeAuto, Mode=OneWay}" Command="{Binding SetThemeCommand}" CommandParameter="Auto" />
                            <RadioButton Style="{DynamicResource Nx.SegmentedItem}" GroupName="Theme" Content="Claro"
                                         IsChecked="{Binding ThemeLight, Mode=OneWay}" Command="{Binding SetThemeCommand}" CommandParameter="Light" />
                            <RadioButton Style="{DynamicResource Nx.SegmentedItem}" GroupName="Theme" Content="Escuro" Margin="0"
                                         IsChecked="{Binding ThemeDark, Mode=OneWay}" Command="{Binding SetThemeCommand}" CommandParameter="Dark" />
                        </StackPanel>
                    </Border>
                </Grid>
            </StackPanel>
        </Border>

        <!-- Identidade -->
        <Border Style="{DynamicResource Nx.Card}" Margin="0,0,0,18">
            <StackPanel>
                <TextBlock Style="{DynamicResource Nx.SectionLabel}" Text="IDENTIDADE DE SEGURANÇA" />
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="150" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="28" />
                        <RowDefinition Height="28" />
                    </Grid.RowDefinitions>
                    <TextBlock Style="{DynamicResource Nx.FieldLabel}" Text="Impressão" />
                    <TextBlock Grid.Column="1" VerticalAlignment="Center" Text="{Binding Fingerprint}" FontFamily="{DynamicResource Nx.Mono}" FontSize="12"
                               ToolTip="{Binding FullFingerprint}" />
                    <TextBlock Grid.Row="1" Style="{DynamicResource Nx.FieldLabel}" Text="Validade" />
                    <TextBlock Grid.Row="1" Grid.Column="1" VerticalAlignment="Center" Text="{Binding ValidityText}" />
                </Grid>
                <TextBlock Style="{DynamicResource Nx.Hint}"
                           Text="Criada automaticamente na primeira abertura e guardada pelo Windows. É ela que o outro lado confere a cada conexão." />
            </StackPanel>
        </Border>

        <!-- Atualização -->
        <Border Style="{DynamicResource Nx.Card}" Margin="0,0,0,18">
            <StackPanel>
                <TextBlock Style="{DynamicResource Nx.SectionLabel}" Text="ATUALIZAÇÃO" />
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <TextBlock VerticalAlignment="Center" TextWrapping="Wrap" Foreground="{DynamicResource Nx.TextMuted}" FontSize="13"
                               Text="{Binding Update.Status}" />
                    <Button Grid.Column="1" Style="{DynamicResource Nx.Button.Small}" Content="Verificar" Command="{Binding Update.CheckCommand}" Margin="10,0,0,0" />
                    <Button Grid.Column="2" Style="{DynamicResource Nx.Button.Primary.Small}" Content="Baixar e instalar" Command="{Binding Update.InstallCommand}" Margin="8,0,0,0"
                            Visibility="{Binding Update.Available, Converter={StaticResource BoolToVisibility}}" />
                </Grid>
            </StackPanel>
        </Border>

        <Grid>
            <Button Style="{DynamicResource Nx.Link}" Content="Abrir pasta de dados" Command="{Binding OpenDataFolderCommand}" HorizontalAlignment="Left" VerticalAlignment="Center" />
            <TextBlock HorizontalAlignment="Center" VerticalAlignment="Center" FontSize="12" Foreground="{DynamicResource Nx.TextSubtle}">
                <Run Text="NexoDesk" /> <Run Text="{Binding Version, Mode=OneWay}" />
            </TextBlock>
            <Button Style="{DynamicResource Nx.Button.Primary}" Content="Fechar" IsCancel="True" IsDefault="True" HorizontalAlignment="Right" Click="OnClose" />
        </Grid>
    </StackPanel>
</ui:NxWindow>
