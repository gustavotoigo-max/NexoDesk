<ui:NxWindow x:Class="NexoDesk.App.Views.SetupWindow"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:ui="clr-namespace:NexoDesk.Ui.Controls;assembly=NexoDesk.Ui"
             xmlns:vm="clr-namespace:NexoDesk.App.ViewModels"
             mc:Ignorable="d"
             d:DataContext="{d:DesignInstance Type=vm:SetupViewModel}"
             Title="NexoDesk"
             Tagline="Primeira configuração"
             Width="760" Height="640" MinWidth="620" MinHeight="560"
             CanMaximize="False"
             WindowStartupLocation="CenterScreen">

    <ui:NxWindow.FooterContent>
        <TextBlock Text="Nexotool · NexoDesk" />
    </ui:NxWindow.FooterContent>

    <Grid Margin="28,24,28,22">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <StackPanel Margin="0,0,0,20">
            <TextBlock Style="{DynamicResource Nx.PageTitle}" Text="Como este computador vai ser usado?" />
            <TextBlock Style="{DynamicResource Nx.PageSubtitle}"
                       Text="O mesmo NexoDesk serve para os dois lados. Dá para mudar depois em Configurações." />
        </StackPanel>

        <!-- ADMIN -->
        <RadioButton Grid.Row="1" Style="{DynamicResource Nx.ChoiceCard}" GroupName="Role" IsChecked="{Binding IsAdmin}" Margin="0,0,0,12">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <Border Width="44" Height="44" CornerRadius="10" Background="{DynamicResource Nx.AccentGradient}" Margin="0,0,16,0" VerticalAlignment="Top">
                    <TextBlock FontFamily="{DynamicResource Nx.Icons}" Text="&#xE7F4;" FontSize="20" Foreground="White" HorizontalAlignment="Center" VerticalAlignment="Center" />
                </Border>
                <StackPanel Grid.Column="1">
                    <TextBlock FontSize="16" FontWeight="SemiBold" Text="ADMIN" />
                    <TextBlock Style="{DynamicResource Nx.Muted}" Margin="0,2,0,0"
                               Text="Este é o computador de onde eu acesso os outros. Aqui ficam a lista dos PCs REMOTOS e o botão Conectar." />
                </StackPanel>
            </Grid>
        </RadioButton>

        <!-- PC REMOTO -->
        <RadioButton Grid.Row="2" Style="{DynamicResource Nx.ChoiceCard}" GroupName="Role" IsChecked="{Binding IsRemote}" Margin="0,0,0,20">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <Border Width="44" Height="44" CornerRadius="10" Background="{DynamicResource Nx.Navy}" Margin="0,0,16,0" VerticalAlignment="Top">
                    <TextBlock FontFamily="{DynamicResource Nx.Icons}" Text="&#xE977;" FontSize="20" Foreground="{DynamicResource Nx.Cyan}" HorizontalAlignment="Center" VerticalAlignment="Center" />
                </Border>
                <StackPanel Grid.Column="1">
                    <TextBlock FontSize="16" FontWeight="SemiBold" Text="PC REMOTO" />
                    <TextBlock Style="{DynamicResource Nx.Muted}" Margin="0,2,0,0"
                               Text="Este computador será acessado pelo ADMIN. Fica aberto perto do relógio, pede permissão a cada acesso e mostra um aviso enquanto alguém estiver conectado." />
                </StackPanel>
            </Grid>
        </RadioButton>

        <!-- Nome -->
        <Grid Grid.Row="3" Margin="0,0,0,16">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="150" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>
            <TextBlock Style="{DynamicResource Nx.FieldLabel}" Text="Nome deste computador" />
            <StackPanel Grid.Column="1">
                <TextBox Style="{DynamicResource Nx.Input}" Text="{Binding DeviceName, UpdateSourceTrigger=PropertyChanged}" MaxLength="64" />
                <TextBlock Style="{DynamicResource Nx.Hint}" Text="Como ele aparece para o outro lado. Ex.: PC Oficina, Notebook Gustavo." />
            </StackPanel>
        </Grid>

        <!-- Tailscale -->
        <Border Grid.Row="4" VerticalAlignment="Top">
            <Border.Style>
                <Style TargetType="Border" BasedOn="{StaticResource Nx.Alert.Warning}">
                    <Style.Triggers>
                        <DataTrigger Binding="{Binding TailscaleOk}" Value="True">
                            <Setter Property="Background" Value="{DynamicResource Nx.SuccessSoft}" />
                            <Setter Property="BorderBrush" Value="{DynamicResource Nx.SuccessBorder}" />
                        </DataTrigger>
                    </Style.Triggers>
                </Style>
            </Border.Style>
            <TextBlock Style="{DynamicResource Nx.AlertText}" Margin="0" Text="{Binding TailscaleText}" />
        </Border>

        <StackPanel Grid.Row="5" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,16,0,0">
            <Button Style="{DynamicResource Nx.Button}" Content="Sair" IsCancel="True" Margin="0,0,10,0" Click="OnCancel" />
            <Button Style="{DynamicResource Nx.Button.Primary}" Content="Continuar" IsDefault="True" Command="{Binding ContinueCommand}" />
        </StackPanel>
    </Grid>
</ui:NxWindow>
