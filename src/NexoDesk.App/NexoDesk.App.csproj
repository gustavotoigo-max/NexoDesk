<Project Sdk="Microsoft.NET.Sdk">

  <!-- NexoDesk: um único programa para os dois papéis (ADMIN e PC REMOTO). -->
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <UseWPF>true</UseWPF>
    <!-- Somente para o ícone da área de notificação (NotifyIcon). -->
    <UseWindowsForms>true</UseWindowsForms>
    <EnableWindowsTargeting>true</EnableWindowsTargeting>
    <RootNamespace>NexoDesk.App</RootNamespace>
    <AssemblyName>NexoDesk</AssemblyName>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <ApplicationIcon>Assets\nexodesk.ico</ApplicationIcon>
    <AssemblyTitle>NexoDesk</AssemblyTitle>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
  </PropertyGroup>

  <!-- WPF e Windows Forms juntos: evita ambiguidades (Application, MessageBox, Button…). Tipos WinForms vão qualificados. -->
  <ItemGroup>
    <Using Remove="System.Windows.Forms" />
    <Using Remove="System.Drawing" />
  </ItemGroup>

  <ItemGroup>
    <Resource Include="Assets\nexodesk.ico" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\NexoDesk.Shared\NexoDesk.Shared.csproj" />
    <ProjectReference Include="..\NexoDesk.Desktop\NexoDesk.Desktop.csproj" />
    <ProjectReference Include="..\NexoDesk.Ui\NexoDesk.Ui.csproj" />
  </ItemGroup>

</Project>
