<Project Sdk="Microsoft.NET.Sdk">

  <!-- Captura de tela e injeção de entrada, sem WPF: usado pelo App (fallback na sessão do
       usuário) e pelo agente SYSTEM (serviço). Segue o desktop de entrada (Default/Winlogon). -->
  <PropertyGroup>
    <TargetFramework>net10.0-windows</TargetFramework>
    <UseWindowsForms>false</UseWindowsForms>
    <UseWPF>false</UseWPF>
    <EnableWindowsTargeting>true</EnableWindowsTargeting>
    <RootNamespace>NexoDesk.Desktop</RootNamespace>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\NexoDesk.Shared\NexoDesk.Shared.csproj" />
  </ItemGroup>

</Project>
