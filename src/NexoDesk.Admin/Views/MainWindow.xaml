<ui:NxWindow x:Class="NexoDesk.Admin.Views.MainWindow"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:ui="clr-namespace:NexoDesk.Ui.Controls;assembly=NexoDesk.Ui"
             xmlns:vm="clr-namespace:NexoDesk.Admin.ViewModels"
             mc:Ignorable="d"
             d:DataContext="{d:DesignInstance Type=vm:MainViewModel}"
             Title="NexoDesk"
             Tagline="Acesso remoto privado"
             Width="1120" Height="760" MinWidth="880" MinHeight="560"
             WindowStartupLocation="CenterScreen">

    <ui:NxWindow.TitleBarContent>
        <ui:NxPill Margin="0,0,4,0" ToolTip="Identidade deste administrador (certificado de cliente)">
            <TextBlock>
                <Run Text="Administrador:" /> <Run Text="{Binding IdentityText, Mode=OneWay}" FontFamily="{DynamicResource Nx.Mono}" />
            </TextBlock>
        </ui:NxPill>
    </ui:NxWindow.TitleBarContent>

    <ui:NxWindow.FooterContent>
        <TextBlock>
            <Run Text="Nexotool · NexoDesk Admin" /> <Run Text="{Binding Version, Mode=OneWay}" />
        </TextBlock>
    </ui:NxWindow.FooterContent>

    <ui:NxWindow.FooterRightContent>
        <StackPanel Orientation="Horizontal">
            <Button Style="{DynamicResource Nx.FooterLink}" Content="Abrir configuração" Command="{Binding OpenConfigCommand}" />
            <TextBlock Text="·" Margin="10,0" Foreground="{DynamicResource Nx.OnNavyMuted}" />
            <Button Style="{DynamicResource Nx.FooterLink}" Content="Pasta de logs" Command="{Binding OpenLogsCommand}" />
        </StackPanel>
    </ui:NxWindow.FooterRightContent>

    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
        <StackPanel Margin="28,22,28,24">

            <!-- Cabeçalho da página -->
            <Grid Margin="0,0,0,18">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <StackPanel>
                    <TextBlock Style="{DynamicResource Nx.PageTitle}" Text="Computadores" />
                    <TextBlock Style="{DynamicResource Nx.PageSubtitle}"
                               Text="Escolha um computador da rede Tailscale para ver a tela. A conexão é autenticada pelos certificados dos dois lados." />
                </StackPanel>
                <Border Grid.Column="1" Style="{DynamicResource Nx.Segmented}" VerticalAlignment="Center" Margin="16,0,0,0" ToolTip="Tema (vale para todos os aplicativos Nexotool)">
                    <StackPanel Orientation="Horizontal">
                        <RadioButton Style="{DynamicResource Nx.SegmentedItem}" GroupName="Theme" Content="Automático"
                                     IsChecked="{Binding ThemeAuto, Mode=OneWay}" Command="{Binding SetThemeCommand}" CommandParameter="Auto" />
                        <RadioButton Style="{DynamicResource Nx.SegmentedItem}" GroupName="Theme" Content="Claro"
                                     IsChecked="{Binding ThemeLight, Mode=OneWay}" Command="{Binding SetThemeCommand}" CommandParameter="Light" />
                        <RadioButton Style="{DynamicResource Nx.SegmentedItem}" GroupName="Theme" Content="Escuro" Margin="0"
                                     IsChecked="{Binding ThemeDark, Mode=OneWay}" Command="{Binding SetThemeCommand}" CommandParameter="Dark" />
                    </StackPanel>
                </Border>
            </Grid>

            <!-- Pendências de configuração -->
            <Border Margin="0,0,0,16">
                <Border.Style>
                    <Style TargetType="Border" BasedOn="{StaticResource Nx.Alert.Warning}">
                        <Setter Property="Visibility" Value="Collapsed" />
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding HasConfigProblem}" Value="True">
                                <Setter Property="Visibility" Value="Visible" />
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </Border.Style>
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <TextBlock FontFamily="{DynamicResource Nx.Icons}" Text="&#xE7BA;" FontSize="16" Foreground="{DynamicResource Nx.Warning}" Margin="0,1,12,0" VerticalAlignment="Top" />
                    <StackPanel Grid.Column="1">
                        <TextBlock Style="{DynamicResource Nx.AlertTitle}" Text="A configuração precisa de ajustes antes de conectar" />
                        <TextBlock Style="{DynamicResource Nx.AlertText}" Text="{Binding ConfigProblem}" />
                        <TextBlock Style="{DynamicResource Nx.AlertText}" Margin="0,6,0,0">
                            <Run Text="Arquivo:" /> <Run Text="{Binding ConfigPath, Mode=OneWay}" FontFamily="{DynamicResource Nx.Mono}" />
                        </TextBlock>
                    </StackPanel>
                    <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center" Margin="12,0,0,0">
                        <Button Style="{DynamicResource Nx.Button.Small}" Content="Abrir configuração" Command="{Binding OpenConfigCommand}" Margin="0,0,8,0" />
                        <Button Style="{DynamicResource Nx.Button.Primary.Small}" Content="Recarregar" Command="{Binding ReloadCommand}" />
                    </StackPanel>
                </Grid>
            </Border>

            <!-- Computadores cadastrados -->
            <Border Style="{DynamicResource Nx.Card}" Margin="0,0,0,16">
                <StackPanel>
                    <Grid Margin="0,0,0,10">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <TextBlock Style="{DynamicResource Nx.SectionLabel}" Text="COMPUTADORES CADASTRADOS" Margin="0" VerticalAlignment="Center" />
                        <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                            <TextBlock Text="{Binding Summary}" FontSize="12" Foreground="{DynamicResource Nx.TextMuted}" Margin="0,0,16,0" VerticalAlignment="Center" />
                            <Button Style="{DynamicResource Nx.Link}" Content="Verificar todos" Command="{Binding CheckAllCommand}" VerticalAlignment="Center" />
                            <TextBlock Style="{DynamicResource Nx.Sep}" />
                            <Button Style="{DynamicResource Nx.Link}" Content="Recarregar catálogo" Command="{Binding ReloadCommand}" VerticalAlignment="Center" />
                        </StackPanel>
                    </Grid>

                    <!-- Tabela -->
                    <Border CornerRadius="10" BorderBrush="{DynamicResource Nx.Border}" BorderThickness="1" ClipToBounds="True">
                        <Border.Style>
                            <Style TargetType="Border">
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding HasMachines}" Value="False">
                                        <Setter Property="Visibility" Value="Collapsed" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Border.Style>
                        <DataGrid Style="{DynamicResource Nx.Table}" ItemsSource="{Binding Machines}" BorderThickness="0" RowHeight="48" MaxHeight="320">
                            <DataGrid.Columns>
                                <DataGridTemplateColumn Header="Computador" Width="2*">
                                    <DataGridTemplateColumn.CellTemplate>
                                        <DataTemplate DataType="{x:Type vm:MachineViewModel}">
                                            <StackPanel ToolTip="{Binding Detail}">
                                                <TextBlock Text="{Binding DisplayName}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" />
                                                <TextBlock Text="{Binding Address}" Style="{DynamicResource Nx.MonoText}" FontSize="11" />
                                            </StackPanel>
                                        </DataTemplate>
                                    </DataGridTemplateColumn.CellTemplate>
                                </DataGridTemplateColumn>
                                <DataGridTemplateColumn Header="Status" Width="130">
                                    <DataGridTemplateColumn.CellTemplate>
                                        <DataTemplate DataType="{x:Type vm:MachineViewModel}">
                                            <ui:NxBadge Kind="{Binding StatusKind}" ShowDot="True" Content="{Binding StatusText}" ToolTip="{Binding Detail}" />
                                        </DataTemplate>
                                    </DataGridTemplateColumn.CellTemplate>
                                </DataGridTemplateColumn>
                                <DataGridTextColumn Header="Última verificação" Width="130" Binding="{Binding LastCheckText}" />
                                <DataGridTextColumn Header="Resposta TCP" Width="110" Binding="{Binding LatencyText}" />
                                <DataGridTemplateColumn Header="" Width="Auto" MinWidth="200">
                                    <DataGridTemplateColumn.CellTemplate>
                                        <DataTemplate DataType="{x:Type vm:MachineViewModel}">
                                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                                                <Button Style="{DynamicResource Nx.Button.Ghost.Small}" Content="Verificar" Margin="0,0,6,0"
                                                        Command="{Binding DataContext.CheckCommand, RelativeSource={RelativeSource AncestorType=DataGrid}}"
                                                        CommandParameter="{Binding}" />
                                                <Button Style="{DynamicResource Nx.Button.Primary.Small}" Content="Conectar" MinWidth="92"
                                                        Command="{Binding DataContext.ConnectCommand, RelativeSource={RelativeSource AncestorType=DataGrid}}"
                                                        CommandParameter="{Binding}" />
                                            </StackPanel>
                                        </DataTemplate>
                                    </DataGridTemplateColumn.CellTemplate>
                                </DataGridTemplateColumn>
                            </DataGrid.Columns>
                        </DataGrid>
                    </Border>

                    <!-- Estado vazio -->
                    <StackPanel HorizontalAlignment="Center" Margin="20,24">
                        <StackPanel.Style>
                            <Style TargetType="StackPanel">
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding HasMachines}" Value="True">
                                        <Setter Property="Visibility" Value="Collapsed" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </StackPanel.Style>
                        <Border Width="44" Height="44" CornerRadius="22" Background="{DynamicResource Nx.SurfaceAlt}" HorizontalAlignment="Center" Margin="0,0,0,10">
                            <TextBlock FontFamily="{DynamicResource Nx.Icons}" Text="&#xE7F4;" FontSize="18" Foreground="{DynamicResource Nx.TextSubtle}"
                                       HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <TextBlock Text="Nenhum computador cadastrado" FontWeight="SemiBold" HorizontalAlignment="Center" />
                        <TextBlock Style="{DynamicResource Nx.Muted}" TextAlignment="Center" MaxWidth="420" Margin="0,6,0,14"
                                   Text="Adicione até 5 computadores em &quot;machines&quot; no arquivo de configuração, com o endereço Tailscale e a impressão do certificado de cada Agent." />
                        <Button Style="{DynamicResource Nx.Button}" Content="Abrir configuração" Command="{Binding OpenConfigCommand}" HorizontalAlignment="Center" />
                    </StackPanel>
                </StackPanel>
            </Border>

            <!-- Conexão -->
            <Border Style="{DynamicResource Nx.Card}" Margin="0,0,0,16">
                <StackPanel>
                    <TextBlock Style="{DynamicResource Nx.SectionLabel}" Text="CONEXÃO" />
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="150" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <TextBlock Style="{DynamicResource Nx.FieldLabel}" Text="Modo" />
                        <StackPanel Grid.Column="1" Orientation="Horizontal">
                            <Border Style="{DynamicResource Nx.Segmented}">
                                <StackPanel Orientation="Horizontal">
                                    <RadioButton Style="{DynamicResource Nx.SegmentedItem}" GroupName="Mode" Content="Visualizar" IsChecked="{Binding ViewMode}" />
                                    <RadioButton Style="{DynamicResource Nx.SegmentedItem}" GroupName="Mode" Content="Controlar" IsChecked="{Binding ControlMode}" Margin="0" />
                                </StackPanel>
                            </Border>
                            <TextBlock Style="{DynamicResource Nx.Hint}" VerticalAlignment="Center" Margin="12,0,0,0"
                                       Text="Controlar (mouse e teclado) chega no marco M5; até lá o Agent recusa esse modo." />
                        </StackPanel>
                    </Grid>

                    <ProgressBar Margin="0,16,0,0" IsIndeterminate="True">
                        <ProgressBar.Style>
                            <Style TargetType="ProgressBar" BasedOn="{StaticResource Nx.Progress}">
                                <Setter Property="Visibility" Value="Collapsed" />
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding IsConnecting}" Value="True">
                                        <Setter Property="Visibility" Value="Visible" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </ProgressBar.Style>
                    </ProgressBar>

                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <TextBlock Style="{DynamicResource Nx.ProgressStatus}" Text="{Binding StatusText}" Tag="{Binding StatusTag}" />
                        <Button Grid.Column="1" Style="{DynamicResource Nx.Button.Small}" Content="Cancelar" Margin="12,8,0,0" VerticalAlignment="Top"
                                Command="{Binding CancelConnectCommand}" />
                    </Grid>
                </StackPanel>
            </Border>

            <!-- Registro -->
            <Border Style="{DynamicResource Nx.Card}">
                <StackPanel>
                    <Grid Margin="0,0,0,8">
                        <TextBlock Style="{DynamicResource Nx.SectionLabel}" Text="REGISTRO" Margin="0" VerticalAlignment="Center" />
                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                            <Button Style="{DynamicResource Nx.Link}" Content="Pasta de logs" Command="{Binding OpenLogsCommand}" />
                            <TextBlock Style="{DynamicResource Nx.Sep}" />
                            <Button Style="{DynamicResource Nx.Link}" Content="Limpar" Command="{Binding ClearLogCommand}" />
                        </StackPanel>
                    </Grid>
                    <Border Style="{DynamicResource Nx.Log}" Height="170">
                        <ScrollViewer x:Name="LogScroll" VerticalScrollBarVisibility="Auto">
                            <ItemsControl ItemsSource="{Binding Log}" ItemTemplate="{DynamicResource Nx.LogLineTemplate}" />
                        </ScrollViewer>
                    </Border>
                </StackPanel>
            </Border>
        </StackPanel>
    </ScrollViewer>
</ui:NxWindow>
