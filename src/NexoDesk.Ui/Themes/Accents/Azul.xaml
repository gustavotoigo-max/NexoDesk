<!-- Nexotool UI — acento de cor "Azul". Sobrepõe as cores de destaque (carregado após o tema). -->
<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <SolidColorBrush x:Key="Nx.Navy" Color="#0B1733" />
    <SolidColorBrush x:Key="Nx.Navy2" Color="#132447" />
    <SolidColorBrush x:Key="Nx.Navy3" Color="#1E3260" />
    <SolidColorBrush x:Key="Nx.Cyan" Color="#22D3EE" />
    <SolidColorBrush x:Key="Nx.Blue" Color="#2563EB" />
    <SolidColorBrush x:Key="Nx.BlueHover" Color="#1D4ED8" />
    <SolidColorBrush x:Key="Nx.BluePressed" Color="#1E40AF" />
    <!-- Tons suaves translúcidos: adaptam-se ao fundo claro ou escuro. -->
    <SolidColorBrush x:Key="Nx.BlueSoft" Color="#2563EB" Opacity="0.14" />
    <SolidColorBrush x:Key="Nx.BlueSelection" Color="#2563EB" Opacity="0.26" />
    <LinearGradientBrush x:Key="Nx.AccentGradient" StartPoint="0,0.5" EndPoint="1,0.5">
        <GradientStop Offset="0" Color="#2563EB" />
        <GradientStop Offset="1" Color="#22D3EE" />
    </LinearGradientBrush>
</ResourceDictionary>
