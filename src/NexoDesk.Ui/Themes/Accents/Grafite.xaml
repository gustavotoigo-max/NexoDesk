<!-- Nexotool UI — acento de cor "Grafite". Sobrepõe as cores de destaque (carregado após o tema). -->
<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <SolidColorBrush x:Key="Nx.Navy" Color="#0F172A" />
    <SolidColorBrush x:Key="Nx.Navy2" Color="#1E293B" />
    <SolidColorBrush x:Key="Nx.Navy3" Color="#334155" />
    <SolidColorBrush x:Key="Nx.Cyan" Color="#38BDF8" />
    <SolidColorBrush x:Key="Nx.Blue" Color="#475569" />
    <SolidColorBrush x:Key="Nx.BlueHover" Color="#334155" />
    <SolidColorBrush x:Key="Nx.BluePressed" Color="#1E293B" />
    <!-- Tons suaves translúcidos: adaptam-se ao fundo claro ou escuro. -->
    <SolidColorBrush x:Key="Nx.BlueSoft" Color="#475569" Opacity="0.14" />
    <SolidColorBrush x:Key="Nx.BlueSelection" Color="#475569" Opacity="0.26" />
    <LinearGradientBrush x:Key="Nx.AccentGradient" StartPoint="0,0.5" EndPoint="1,0.5">
        <GradientStop Offset="0" Color="#475569" />
        <GradientStop Offset="1" Color="#38BDF8" />
    </LinearGradientBrush>
</ResourceDictionary>
