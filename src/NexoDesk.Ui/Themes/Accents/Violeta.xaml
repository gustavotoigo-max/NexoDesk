<!-- Nexotool UI — acento de cor "Violeta". Sobrepõe as cores de destaque (carregado após o tema). -->
<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <SolidColorBrush x:Key="Nx.Navy" Color="#1E1033" />
    <SolidColorBrush x:Key="Nx.Navy2" Color="#2A1A4A" />
    <SolidColorBrush x:Key="Nx.Navy3" Color="#3A2663" />
    <SolidColorBrush x:Key="Nx.Cyan" Color="#C084FC" />
    <SolidColorBrush x:Key="Nx.Blue" Color="#7C3AED" />
    <SolidColorBrush x:Key="Nx.BlueHover" Color="#6D28D9" />
    <SolidColorBrush x:Key="Nx.BluePressed" Color="#5B21B6" />
    <!-- Tons suaves translúcidos: adaptam-se ao fundo claro ou escuro. -->
    <SolidColorBrush x:Key="Nx.BlueSoft" Color="#7C3AED" Opacity="0.14" />
    <SolidColorBrush x:Key="Nx.BlueSelection" Color="#7C3AED" Opacity="0.26" />
    <LinearGradientBrush x:Key="Nx.AccentGradient" StartPoint="0,0.5" EndPoint="1,0.5">
        <GradientStop Offset="0" Color="#7C3AED" />
        <GradientStop Offset="1" Color="#C084FC" />
    </LinearGradientBrush>
</ResourceDictionary>
