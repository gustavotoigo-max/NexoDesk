<!-- Nexotool UI — acento de cor "Esmeralda". Sobrepõe as cores de destaque (carregado após o tema). -->
<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <SolidColorBrush x:Key="Nx.Navy" Color="#07261F" />
    <SolidColorBrush x:Key="Nx.Navy2" Color="#0D3A2F" />
    <SolidColorBrush x:Key="Nx.Navy3" Color="#14513F" />
    <SolidColorBrush x:Key="Nx.Cyan" Color="#34D399" />
    <SolidColorBrush x:Key="Nx.Blue" Color="#059669" />
    <SolidColorBrush x:Key="Nx.BlueHover" Color="#047857" />
    <SolidColorBrush x:Key="Nx.BluePressed" Color="#065F46" />
    <!-- Tons suaves translúcidos: adaptam-se ao fundo claro ou escuro. -->
    <SolidColorBrush x:Key="Nx.BlueSoft" Color="#059669" Opacity="0.14" />
    <SolidColorBrush x:Key="Nx.BlueSelection" Color="#059669" Opacity="0.26" />
    <LinearGradientBrush x:Key="Nx.AccentGradient" StartPoint="0,0.5" EndPoint="1,0.5">
        <GradientStop Offset="0" Color="#059669" />
        <GradientStop Offset="1" Color="#34D399" />
    </LinearGradientBrush>
</ResourceDictionary>
