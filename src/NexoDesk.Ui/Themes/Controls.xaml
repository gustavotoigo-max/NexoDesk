<!--
  Nexotool UI — estilos de controles para WPF.
  Todas as cores usam DynamicResource para permitir troca de tema em tempo de execução.
  Medidas do guia: controle 36 px (pequeno 30), raio 8 (controle) / 12 (cartão) / 10 (log e tabela), coluna de rótulo 150 px.
-->
<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:ui="clr-namespace:NexoDesk.Ui">

    <!-- Conversores -->
    <ui:BoolToVisibilityConverter x:Key="BoolToVisibility" />
    <ui:BoolToVisibilityConverter x:Key="InverseBoolToVisibility" Invert="True" />

    <!-- ============================== Foco ============================== -->
    <!-- Anel ciano de 2 px, afastado 3 px -->
    <Style x:Key="Nx.FocusVisual">
        <Setter Property="Control.Template">
            <Setter.Value>
                <ControlTemplate>
                    <Rectangle Margin="-3" RadiusX="10" RadiusY="10" Stroke="{DynamicResource Nx.Cyan}" StrokeThickness="2" SnapsToDevicePixels="True" />
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- ============================== Texto ============================== -->
    <Style x:Key="Nx.PageTitle" TargetType="TextBlock">
        <Setter Property="FontSize" Value="22" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="Foreground" Value="{DynamicResource Nx.Text}" />
        <Setter Property="TextTrimming" Value="CharacterEllipsis" />
    </Style>
    <Style x:Key="Nx.PageSubtitle" TargetType="TextBlock">
        <Setter Property="FontSize" Value="13.5" />
        <Setter Property="Foreground" Value="{DynamicResource Nx.TextMuted}" />
        <Setter Property="Margin" Value="0,4,0,0" />
        <Setter Property="TextWrapping" Value="Wrap" />
    </Style>
    <!-- Rótulo de seção: escreva o texto em MAIÚSCULAS -->
    <Style x:Key="Nx.SectionLabel" TargetType="TextBlock">
        <Setter Property="FontSize" Value="11" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="Foreground" Value="{DynamicResource Nx.TextSubtle}" />
        <Setter Property="Margin" Value="0,0,0,8" />
    </Style>
    <Style x:Key="Nx.FieldLabel" TargetType="TextBlock">
        <Setter Property="FontSize" Value="13" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="Foreground" Value="{DynamicResource Nx.Text}" />
        <Setter Property="VerticalAlignment" Value="Center" />
        <Setter Property="TextTrimming" Value="CharacterEllipsis" />
    </Style>
    <Style x:Key="Nx.Body" TargetType="TextBlock">
        <Setter Property="FontSize" Value="13" />
        <Setter Property="Foreground" Value="{DynamicResource Nx.Text}" />
        <Setter Property="TextWrapping" Value="Wrap" />
    </Style>
    <Style x:Key="Nx.Muted" TargetType="TextBlock" BasedOn="{StaticResource Nx.Body}">
        <Setter Property="Foreground" Value="{DynamicResource Nx.TextMuted}" />
    </Style>
    <Style x:Key="Nx.Hint" TargetType="TextBlock">
        <Setter Property="FontSize" Value="11.5" />
        <Setter Property="Foreground" Value="{DynamicResource Nx.TextSubtle}" />
        <Setter Property="Margin" Value="0,6,0,0" />
        <Setter Property="TextWrapping" Value="Wrap" />
    </Style>
    <Style x:Key="Nx.MonoText" TargetType="TextBlock">
        <Setter Property="FontFamily" Value="{DynamicResource Nx.Mono}" />
        <Setter Property="FontSize" Value="12" />
        <Setter Property="Foreground" Value="{DynamicResource Nx.TextMuted}" />
        <Setter Property="TextTrimming" Value="CharacterEllipsis" />
    </Style>

    <!-- Linha de estado (progresso): use Tag = Ready | Working | Done | Warn | Cancelled | Error -->
    <Style x:Key="Nx.ProgressStatus" TargetType="TextBlock">
        <Setter Property="FontSize" Value="13" />
        <Setter Property="Margin" Value="0,10,0,0" />
        <Setter Property="TextWrapping" Value="Wrap" />
        <Setter Property="Foreground" Value="{DynamicResource Nx.TextMuted}" />
        <Style.Triggers>
            <Trigger Property="Tag" Value="Working">
                <Setter Property="Foreground" Value="{DynamicResource Nx.Text}" />
            </Trigger>
            <Trigger Property="Tag" Value="Done">
                <Setter Property="Foreground" Value="{DynamicResource Nx.Success}" />
            </Trigger>
            <Trigger Property="Tag" Value="Warn">
                <Setter Property="Foreground" Value="{DynamicResource Nx.Warning}" />
            </Trigger>
            <Trigger Property="Tag" Value="Cancelled">
                <Setter Property="Foreground" Value="{DynamicResource Nx.Warning}" />
            </Trigger>
            <Trigger Property="Tag" Value="Error">
                <Setter Property="Foreground" Value="{DynamicResource Nx.Danger}" />
            </Trigger>
        </Style.Triggers>
    </Style>

    <!-- ============================== Cartões ============================== -->
    <Style x:Key="Nx.Card" TargetType="Border">
        <Setter Property="Background" Value="{DynamicResource Nx.Surface}" />
        <Setter Property="BorderBrush" Value="{DynamicResource Nx.Border}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="CornerRadius" Value="{StaticResource Nx.Radius.Card}" />
        <Setter Property="Padding" Value="20" />
    </Style>
    <Style x:Key="Nx.Card.Compact" TargetType="Border" BasedOn="{StaticResource Nx.Card}">
        <Setter Property="Padding" Value="20,16" />
    </Style>

    <!-- Log: fundo azul-marinho, fonte mono 12 px -->
    <Style x:Key="Nx.Log" TargetType="Border">
        <Setter Property="Background" Value="{DynamicResource Nx.Navy}" />
        <Setter Property="CornerRadius" Value="{StaticResource Nx.Radius.Card}" />
        <Setter Property="Padding" Value="14,12" />
        <Setter Property="TextElement.Foreground" Value="{DynamicResource Nx.LogText}" />
        <Setter Property="TextElement.FontFamily" Value="{DynamicResource Nx.Mono}" />
        <Setter Property="TextElement.FontSize" Value="12" />
    </Style>

    <!-- Faixa de aviso: Nx.Alert (informação), .Success, .Warning, .Danger -->
    <Style x:Key="Nx.Alert" TargetType="Border">
        <Setter Property="Background" Value="{DynamicResource Nx.InfoSoft}" />
        <Setter Property="BorderBrush" Value="{DynamicResource Nx.InfoBorder}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="CornerRadius" Value="{StaticResource Nx.Radius.Card}" />
        <Setter Property="Padding" Value="16,12" />
    </Style>
    <Style x:Key="Nx.Alert.Success" TargetType="Border" BasedOn="{StaticResource Nx.Alert}">
        <Setter Property="Background" Value="{DynamicResource Nx.SuccessSoft}" />
        <Setter Property="BorderBrush" Value="{DynamicResource Nx.SuccessBorder}" />
    </Style>
    <Style x:Key="Nx.Alert.Warning" TargetType="Border" BasedOn="{StaticResource Nx.Alert}">
        <Setter Property="Background" Value="{DynamicResource Nx.WarningSoft}" />
        <Setter Property="BorderBrush" Value="{DynamicResource Nx.WarningBorder}" />
    </Style>
    <Style x:Key="Nx.Alert.Danger" TargetType="Border" BasedOn="{StaticResource Nx.Alert}">
        <Setter Property="Background" Value="{DynamicResource Nx.DangerSoft}" />
        <Setter Property="BorderBrush" Value="{DynamicResource Nx.DangerBorder}" />
    </Style>
    <Style x:Key="Nx.AlertTitle" TargetType="TextBlock">
        <Setter Property="FontSize" Value="13" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="Foreground" Value="{DynamicResource Nx.Text}" />
        <Setter Property="TextWrapping" Value="Wrap" />
    </Style>
    <Style x:Key="Nx.AlertText" TargetType="TextBlock">
        <Setter Property="FontSize" Value="12" />
        <Setter Property="Foreground" Value="{DynamicResource Nx.TextMuted}" />
        <Setter Property="TextWrapping" Value="Wrap" />
        <Setter Property="Margin" Value="0,2,0,0" />
    </Style>

    <!-- ============================== Botões ============================== -->
    <Style x:Key="Nx.Button" TargetType="Button">
        <Setter Property="FocusVisualStyle" Value="{StaticResource Nx.FocusVisual}" />
        <Setter Property="FontSize" Value="13" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="Height" Value="36" />
        <Setter Property="MinWidth" Value="120" />
        <Setter Property="Padding" Value="16,0" />
        <Setter Property="Background" Value="{DynamicResource Nx.Surface}" />
        <Setter Property="BorderBrush" Value="{DynamicResource Nx.BorderStrong}" />
        <Setter Property="Foreground" Value="{DynamicResource Nx.Text}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="HorizontalContentAlignment" Value="Center" />
        <Setter Property="VerticalContentAlignment" Value="Center" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border x:Name="Chrome"
                            Background="{TemplateBinding Background}"
                            BorderBrush="{TemplateBinding BorderBrush}"
                            BorderThickness="{TemplateBinding BorderThickness}"
                            CornerRadius="{StaticResource Nx.Radius.Button}"
                            SnapsToDevicePixels="True">
                        <ContentPresenter Margin="{TemplateBinding Padding}"
                                          HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                                          VerticalAlignment="{TemplateBinding VerticalContentAlignment}"
                                          RecognizesAccessKey="True" />
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsPressed" Value="True">
                            <Setter TargetName="Chrome" Property="Opacity" Value="0.88" />
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter TargetName="Chrome" Property="Opacity" Value="0.45" />
                            <Setter Property="Cursor" Value="Arrow" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
        <Style.Triggers>
            <Trigger Property="IsMouseOver" Value="True">
                <Setter Property="Background" Value="{DynamicResource Nx.SurfaceAlt}" />
            </Trigger>
        </Style.Triggers>
    </Style>

    <Style x:Key="Nx.Button.Primary" TargetType="Button" BasedOn="{StaticResource Nx.Button}">
        <Setter Property="Background" Value="{DynamicResource Nx.Blue}" />
        <Setter Property="BorderBrush" Value="{DynamicResource Nx.Blue}" />
        <Setter Property="Foreground" Value="{DynamicResource Nx.White}" />
        <Style.Triggers>
            <Trigger Property="IsMouseOver" Value="True">
                <Setter Property="Background" Value="{DynamicResource Nx.BlueHover}" />
                <Setter Property="BorderBrush" Value="{DynamicResource Nx.BlueHover}" />
            </Trigger>
        </Style.Triggers>
    </Style>

    <Style x:Key="Nx.Button.Danger" TargetType="Button" BasedOn="{StaticResource Nx.Button}">
        <Setter Property="Foreground" Value="{DynamicResource Nx.Danger}" />
        <Setter Property="BorderBrush" Value="{DynamicResource Nx.DangerBorder}" />
        <Style.Triggers>
            <Trigger Property="IsMouseOver" Value="True">
                <Setter Property="Background" Value="{DynamicResource Nx.DangerSoft}" />
            </Trigger>
        </Style.Triggers>
    </Style>

    <Style x:Key="Nx.Button.DangerSolid" TargetType="Button" BasedOn="{StaticResource Nx.Button}">
        <Setter Property="Background" Value="{DynamicResource Nx.Danger}" />
        <Setter Property="BorderBrush" Value="{DynamicResource Nx.Danger}" />
        <Setter Property="Foreground" Value="{DynamicResource Nx.White}" />
        <Style.Triggers>
            <Trigger Property="IsMouseOver" Value="True">
                <Setter Property="Background" Value="{DynamicResource Nx.DangerHover}" />
                <Setter Property="BorderBrush" Value="{DynamicResource Nx.DangerHover}" />
            </Trigger>
        </Style.Triggers>
    </Style>

    <Style x:Key="Nx.Button.Ghost" TargetType="Button" BasedOn="{StaticResource Nx.Button}">
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="BorderBrush" Value="Transparent" />
        <Setter Property="Foreground" Value="{DynamicResource Nx.Blue}" />
        <Setter Property="MinWidth" Value="0" />
        <Style.Triggers>
            <Trigger Property="IsMouseOver" Value="True">
                <Setter Property="Background" Value="{DynamicResource Nx.BlueSoft}" />
            </Trigger>
        </Style.Triggers>
    </Style>

    <Style x:Key="Nx.Button.Navy" TargetType="Button" BasedOn="{StaticResource Nx.Button}">
        <Setter Property="Height" Value="26" />
        <Setter Property="MinWidth" Value="0" />
        <Setter Property="Padding" Value="9,0" />
        <Setter Property="FontSize" Value="12" />
        <Setter Property="Background" Value="{DynamicResource Nx.Navy2}" />
        <Setter Property="BorderBrush" Value="{DynamicResource Nx.Navy3}" />
        <Setter Property="Foreground" Value="{DynamicResource Nx.OnNavy}" />
        <Style.Triggers>
            <Trigger Property="IsMouseOver" Value="True">
                <Setter Property="Background" Value="{DynamicResource Nx.Navy3}" />
            </Trigger>
        </Style.Triggers>
    </Style>

    <!-- Variações pequenas (30 px) -->
    <Style x:Key="Nx.Button.Small" TargetType="Button" BasedOn="{StaticResource Nx.Button}">
        <Setter Property="Height" Value="30" />
        <Setter Property="MinWidth" Value="0" />
        <Setter Property="Padding" Value="12,0" />
        <Setter Property="FontSize" Value="12.5" />
    </Style>
    <Style x:Key="Nx.Button.Primary.Small" TargetType="Button" BasedOn="{StaticResource Nx.Button.Primary}">
        <Setter Property="Height" Value="30" />
        <Setter Property="MinWidth" Value="0" />
        <Setter Property="Padding" Value="12,0" />
        <Setter Property="FontSize" Value="12.5" />
    </Style>
    <Style x:Key="Nx.Button.Ghost.Small" TargetType="Button" BasedOn="{StaticResource Nx.Button.Ghost}">
        <Setter Property="Height" Value="30" />
        <Setter Property="Padding" Value="10,0" />
        <Setter Property="FontSize" Value="12.5" />
    </Style>
    <Style x:Key="Nx.Button.DangerSolid.Small" TargetType="Button" BasedOn="{StaticResource Nx.Button.DangerSolid}">
        <Setter Property="Height" Value="30" />
        <Setter Property="MinWidth" Value="0" />
        <Setter Property="Padding" Value="12,0" />
        <Setter Property="FontSize" Value="12.5" />
    </Style>

    <!-- Link de texto (ações de cartão: "Exportar relatório · Limpar") -->
    <Style x:Key="Nx.Link" TargetType="Button">
        <Setter Property="FocusVisualStyle" Value="{StaticResource Nx.FocusVisual}" />
        <Setter Property="Foreground" Value="{DynamicResource Nx.Blue}" />
        <Setter Property="FontSize" Value="12.5" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border Background="Transparent">
                        <TextBlock x:Name="Text" Text="{Binding Content, RelativeSource={RelativeSource TemplatedParent}}" />
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Text" Property="TextDecorations" Value="Underline" />
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter Property="Foreground" Value="{DynamicResource Nx.TextSubtle}" />
                            <Setter Property="Cursor" Value="Arrow" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- Link no rodapé azul-marinho -->
    <Style x:Key="Nx.FooterLink" TargetType="Button" BasedOn="{StaticResource Nx.Link}">
        <Setter Property="Foreground" Value="{DynamicResource Nx.OnNavyMuted}" />
        <Setter Property="FontSize" Value="12" />
        <Style.Triggers>
            <Trigger Property="IsMouseOver" Value="True">
                <Setter Property="Foreground" Value="{DynamicResource Nx.Cyan}" />
            </Trigger>
        </Style.Triggers>
    </Style>

    <!-- Botões da barra de título -->
    <Style x:Key="Nx.CaptionButton" TargetType="Button">
        <Setter Property="Width" Value="46" />
        <Setter Property="Foreground" Value="{DynamicResource Nx.OnNavy}" />
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="FontFamily" Value="{DynamicResource Nx.Icons}" />
        <Setter Property="FontSize" Value="10" />
        <Setter Property="Focusable" Value="False" />
        <Setter Property="IsTabStop" Value="False" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border Background="{TemplateBinding Background}">
                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                    </Border>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
        <Style.Triggers>
            <Trigger Property="IsMouseOver" Value="True">
                <Setter Property="Background" Value="{DynamicResource Nx.Navy3}" />
            </Trigger>
        </Style.Triggers>
    </Style>
    <Style x:Key="Nx.CaptionButton.Close" TargetType="Button" BasedOn="{StaticResource Nx.CaptionButton}">
        <Style.Triggers>
            <Trigger Property="IsMouseOver" Value="True">
                <Setter Property="Background" Value="{DynamicResource Nx.Close}" />
                <Setter Property="Foreground" Value="{DynamicResource Nx.White}" />
            </Trigger>
        </Style.Triggers>
    </Style>

    <!-- ============================== Campos ============================== -->
    <Style x:Key="Nx.Input" TargetType="TextBox">
        <Setter Property="FontSize" Value="13" />
        <Setter Property="Height" Value="36" />
        <Setter Property="Padding" Value="9,0" />
        <Setter Property="VerticalContentAlignment" Value="Center" />
        <Setter Property="Foreground" Value="{DynamicResource Nx.Text}" />
        <Setter Property="Background" Value="{DynamicResource Nx.Surface}" />
        <Setter Property="BorderBrush" Value="{DynamicResource Nx.BorderStrong}" />
        <Setter Property="CaretBrush" Value="{DynamicResource Nx.Blue}" />
        <Setter Property="SelectionBrush" Value="{DynamicResource Nx.Blue}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="FocusVisualStyle" Value="{x:Null}" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="TextBox">
                    <Border x:Name="Frame"
                            Background="{TemplateBinding Background}"
                            BorderBrush="{TemplateBinding BorderBrush}"
                            BorderThickness="{TemplateBinding BorderThickness}"
                            CornerRadius="{StaticResource Nx.Radius.Control}"
                            SnapsToDevicePixels="True">
                        <ScrollViewer x:Name="PART_ContentHost" Margin="{TemplateBinding Padding}" VerticalAlignment="{TemplateBinding VerticalContentAlignment}" Focusable="False" />
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Frame" Property="BorderBrush" Value="{DynamicResource Nx.BorderHover}" />
                        </Trigger>
                        <Trigger Property="IsKeyboardFocused" Value="True">
                            <Setter TargetName="Frame" Property="BorderBrush" Value="{DynamicResource Nx.Blue}" />
                            <Setter TargetName="Frame" Property="BorderThickness" Value="2" />
                            <Setter TargetName="PART_ContentHost" Property="Margin" Value="8,0" />
                        </Trigger>
                        <Trigger Property="IsReadOnly" Value="True">
                            <Setter TargetName="Frame" Property="Background" Value="{DynamicResource Nx.SurfaceAlt}" />
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter TargetName="Frame" Property="Background" Value="{DynamicResource Nx.SurfaceAlt}" />
                            <Setter Property="Foreground" Value="{DynamicResource Nx.TextSubtle}" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>
    <Style x:Key="Nx.Input.Mono" TargetType="TextBox" BasedOn="{StaticResource Nx.Input}">
        <Setter Property="FontFamily" Value="{DynamicResource Nx.Mono}" />
        <Setter Property="FontSize" Value="12" />
    </Style>

    <!-- Caixa de seleção 18 px, raio 5 -->
    <Style x:Key="Nx.Check" TargetType="CheckBox">
        <Setter Property="FocusVisualStyle" Value="{StaticResource Nx.FocusVisual}" />
        <Setter Property="Foreground" Value="{DynamicResource Nx.Text}" />
        <Setter Property="FontSize" Value="13" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="CheckBox">
                    <StackPanel Orientation="Horizontal" Background="Transparent">
                        <Border x:Name="Box" Width="18" Height="18" CornerRadius="5" BorderThickness="1.5"
                                BorderBrush="{DynamicResource Nx.BorderStrong}" Background="{DynamicResource Nx.Surface}" VerticalAlignment="Center">
                            <Path x:Name="Mark" Data="M 3.5,9.2 L 7.3,12.8 L 14.5,5.2" Stroke="{DynamicResource Nx.White}" StrokeThickness="1.9"
                                  StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round" Visibility="Collapsed" Margin="-1.5" />
                        </Border>
                        <ContentPresenter Margin="8,0,0,0" VerticalAlignment="Center" RecognizesAccessKey="True" />
                    </StackPanel>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Box" Property="BorderBrush" Value="{DynamicResource Nx.Blue}" />
                        </Trigger>
                        <Trigger Property="IsChecked" Value="True">
                            <Setter TargetName="Box" Property="Background" Value="{DynamicResource Nx.Blue}" />
                            <Setter TargetName="Box" Property="BorderBrush" Value="{DynamicResource Nx.Blue}" />
                            <Setter TargetName="Mark" Property="Visibility" Value="Visible" />
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter Property="Opacity" Value="0.5" />
                            <Setter Property="Cursor" Value="Arrow" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- Interruptor liga/desliga 36 × 20 -->
    <Style x:Key="Nx.Switch" TargetType="CheckBox">
        <Setter Property="FocusVisualStyle" Value="{StaticResource Nx.FocusVisual}" />
        <Setter Property="Foreground" Value="{DynamicResource Nx.Text}" />
        <Setter Property="FontSize" Value="13" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="CheckBox">
                    <StackPanel Orientation="Horizontal" Background="Transparent">
                        <Border x:Name="Track" Width="36" Height="20" CornerRadius="10" BorderThickness="1"
                                Background="{DynamicResource Nx.DisabledFill}" BorderBrush="{DynamicResource Nx.BorderStrong}" VerticalAlignment="Center">
                            <Ellipse x:Name="Knob" Width="14" Height="14" HorizontalAlignment="Left" Margin="2,0,0,0" Fill="{DynamicResource Nx.TextSubtle}" />
                        </Border>
                        <ContentPresenter Margin="10,0,0,0" VerticalAlignment="Center" RecognizesAccessKey="True" />
                    </StackPanel>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsChecked" Value="True">
                            <Setter TargetName="Track" Property="Background" Value="{DynamicResource Nx.Blue}" />
                            <Setter TargetName="Track" Property="BorderBrush" Value="{DynamicResource Nx.Blue}" />
                            <Setter TargetName="Knob" Property="Fill" Value="{DynamicResource Nx.White}" />
                            <Setter TargetName="Knob" Property="Margin" Value="18,0,0,0" />
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter Property="Opacity" Value="0.5" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- Controle segmentado: um Border com Nx.Segmented contendo RadioButtons com Nx.SegmentedItem -->
    <Style x:Key="Nx.Segmented" TargetType="Border">
        <Setter Property="Background" Value="{DynamicResource Nx.SurfaceAlt}" />
        <Setter Property="BorderBrush" Value="{DynamicResource Nx.Border}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="CornerRadius" Value="{StaticResource Nx.Radius.Card}" />
        <Setter Property="Padding" Value="3" />
        <Setter Property="HorizontalAlignment" Value="Left" />
    </Style>
    <Style x:Key="Nx.SegmentedItem" TargetType="RadioButton">
        <Setter Property="FocusVisualStyle" Value="{StaticResource Nx.FocusVisual}" />
        <Setter Property="FontSize" Value="12.5" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="Height" Value="30" />
        <Setter Property="Padding" Value="14,0" />
        <Setter Property="Margin" Value="0,0,2,0" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="Foreground" Value="{DynamicResource Nx.TextMuted}" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="RadioButton">
                    <Border x:Name="Pill" CornerRadius="{StaticResource Nx.Radius.Control}" Background="Transparent" BorderThickness="1" BorderBrush="Transparent" Padding="{TemplateBinding Padding}">
                        <ContentPresenter VerticalAlignment="Center" HorizontalAlignment="Center" RecognizesAccessKey="True" />
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter Property="Foreground" Value="{DynamicResource Nx.Text}" />
                        </Trigger>
                        <Trigger Property="IsChecked" Value="True">
                            <Setter TargetName="Pill" Property="Background" Value="{DynamicResource Nx.Surface}" />
                            <Setter TargetName="Pill" Property="BorderBrush" Value="{DynamicResource Nx.BorderStrong}" />
                            <Setter Property="Foreground" Value="{DynamicResource Nx.Blue}" />
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter Property="Opacity" Value="0.45" />
                            <Setter Property="Cursor" Value="Arrow" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- ============================== Progresso ============================== -->
    <Style x:Key="Nx.Progress" TargetType="ProgressBar">
        <Setter Property="Height" Value="8" />
        <Setter Property="Minimum" Value="0" />
        <Setter Property="Maximum" Value="100" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ProgressBar">
                    <Grid x:Name="TemplateRoot" ClipToBounds="True">
                        <VisualStateManager.VisualStateGroups>
                            <VisualStateGroup x:Name="CommonStates">
                                <VisualState x:Name="Determinate" />
                                <VisualState x:Name="Indeterminate">
                                    <Storyboard RepeatBehavior="Forever">
                                        <DoubleAnimation Storyboard.TargetName="Runner"
                                                         Storyboard.TargetProperty="(UIElement.RenderTransform).(TranslateTransform.X)"
                                                         From="-120" To="600" Duration="0:0:1.4">
                                            <DoubleAnimation.EasingFunction>
                                                <CubicEase EasingMode="EaseInOut" />
                                            </DoubleAnimation.EasingFunction>
                                        </DoubleAnimation>
                                    </Storyboard>
                                </VisualState>
                            </VisualStateGroup>
                        </VisualStateManager.VisualStateGroups>
                        <Border x:Name="PART_Track" CornerRadius="4" Background="{DynamicResource Nx.DisabledFill}" />
                        <Border x:Name="PART_Indicator" CornerRadius="4" Background="{DynamicResource Nx.AccentGradient}" HorizontalAlignment="Left" />
                        <Border x:Name="Runner" Width="120" CornerRadius="4" Background="{DynamicResource Nx.AccentGradient}" HorizontalAlignment="Left" Visibility="Collapsed">
                            <Border.RenderTransform>
                                <TranslateTransform X="-120" />
                            </Border.RenderTransform>
                        </Border>
                    </Grid>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsIndeterminate" Value="True">
                            <Setter TargetName="PART_Indicator" Property="Visibility" Value="Collapsed" />
                            <Setter TargetName="Runner" Property="Visibility" Value="Visible" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- ============================== Tabela ============================== -->
    <Style x:Key="Nx.TableHeader" TargetType="DataGridColumnHeader">
        <Setter Property="Height" Value="38" />
        <Setter Property="Padding" Value="12,0" />
        <Setter Property="FontSize" Value="11.5" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="Foreground" Value="{DynamicResource Nx.TextMuted}" />
        <Setter Property="Background" Value="{DynamicResource Nx.SurfaceAlt}" />
        <Setter Property="BorderBrush" Value="{DynamicResource Nx.Border}" />
        <Setter Property="BorderThickness" Value="0,0,0,1" />
        <Setter Property="HorizontalContentAlignment" Value="Left" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="DataGridColumnHeader">
                    <Border Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" Padding="{TemplateBinding Padding}">
                        <ContentPresenter VerticalAlignment="Center" HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}" />
                    </Border>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="Nx.TableCell" TargetType="DataGridCell">
        <Setter Property="FocusVisualStyle" Value="{x:Null}" />
        <Setter Property="BorderThickness" Value="0" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="DataGridCell">
                    <Border Background="Transparent" Padding="12,0">
                        <ContentPresenter VerticalAlignment="Center" />
                    </Border>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="Nx.TableRow" TargetType="DataGridRow">
        <Setter Property="Background" Value="{DynamicResource Nx.Surface}" />
        <Setter Property="Foreground" Value="{DynamicResource Nx.Text}" />
        <Style.Triggers>
            <Trigger Property="ItemsControl.AlternationIndex" Value="1">
                <Setter Property="Background" Value="{DynamicResource Nx.SurfaceAlt}" />
            </Trigger>
            <Trigger Property="IsMouseOver" Value="True">
                <Setter Property="Background" Value="{DynamicResource Nx.BlueSoft}" />
            </Trigger>
            <Trigger Property="IsSelected" Value="True">
                <Setter Property="Background" Value="{DynamicResource Nx.BlueSelection}" />
            </Trigger>
        </Style.Triggers>
    </Style>

    <Style x:Key="Nx.Table" TargetType="DataGrid">
        <Setter Property="AutoGenerateColumns" Value="False" />
        <Setter Property="CanUserAddRows" Value="False" />
        <Setter Property="CanUserDeleteRows" Value="False" />
        <Setter Property="CanUserResizeRows" Value="False" />
        <Setter Property="CanUserReorderColumns" Value="False" />
        <Setter Property="IsReadOnly" Value="True" />
        <Setter Property="SelectionMode" Value="Single" />
        <Setter Property="SelectionUnit" Value="FullRow" />
        <Setter Property="HeadersVisibility" Value="Column" />
        <Setter Property="GridLinesVisibility" Value="Horizontal" />
        <Setter Property="HorizontalGridLinesBrush" Value="{DynamicResource Nx.Border}" />
        <Setter Property="RowHeight" Value="38" />
        <Setter Property="FontSize" Value="12.5" />
        <Setter Property="AlternationCount" Value="2" />
        <Setter Property="Background" Value="{DynamicResource Nx.Surface}" />
        <Setter Property="Foreground" Value="{DynamicResource Nx.Text}" />
        <Setter Property="BorderBrush" Value="{DynamicResource Nx.Border}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="ColumnHeaderStyle" Value="{StaticResource Nx.TableHeader}" />
        <Setter Property="CellStyle" Value="{StaticResource Nx.TableCell}" />
        <Setter Property="RowStyle" Value="{StaticResource Nx.TableRow}" />
        <Setter Property="VerticalScrollBarVisibility" Value="Auto" />
        <Setter Property="HorizontalScrollBarVisibility" Value="Disabled" />
    </Style>

    <!-- ============================== Rolagem fina ============================== -->
    <Style x:Key="Nx.ScrollThumb" TargetType="Thumb">
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Thumb">
                    <Border CornerRadius="4" Background="{DynamicResource Nx.Scroll}" Opacity="0.7" Margin="2" />
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>
    <Style x:Key="Nx.ScrollPage" TargetType="RepeatButton">
        <Setter Property="Focusable" Value="False" />
        <Setter Property="IsTabStop" Value="False" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="RepeatButton">
                    <Border Background="Transparent" />
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>
    <Style TargetType="ScrollBar">
        <Setter Property="Width" Value="10" />
        <Setter Property="MinWidth" Value="10" />
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ScrollBar">
                    <Grid Background="{TemplateBinding Background}">
                        <Track x:Name="PART_Track" IsDirectionReversed="True">
                            <Track.DecreaseRepeatButton>
                                <RepeatButton Style="{StaticResource Nx.ScrollPage}" Command="ScrollBar.PageUpCommand" />
                            </Track.DecreaseRepeatButton>
                            <Track.Thumb>
                                <Thumb Style="{StaticResource Nx.ScrollThumb}" />
                            </Track.Thumb>
                            <Track.IncreaseRepeatButton>
                                <RepeatButton Style="{StaticResource Nx.ScrollPage}" Command="ScrollBar.PageDownCommand" />
                            </Track.IncreaseRepeatButton>
                        </Track>
                    </Grid>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
        <Style.Triggers>
            <Trigger Property="Orientation" Value="Horizontal">
                <Setter Property="Width" Value="Auto" />
                <Setter Property="MinWidth" Value="0" />
                <Setter Property="Height" Value="10" />
                <Setter Property="MinHeight" Value="10" />
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="ScrollBar">
                            <Grid Background="{TemplateBinding Background}">
                                <Track x:Name="PART_Track" IsDirectionReversed="False">
                                    <Track.DecreaseRepeatButton>
                                        <RepeatButton Style="{StaticResource Nx.ScrollPage}" Command="ScrollBar.PageLeftCommand" />
                                    </Track.DecreaseRepeatButton>
                                    <Track.Thumb>
                                        <Thumb Style="{StaticResource Nx.ScrollThumb}" />
                                    </Track.Thumb>
                                    <Track.IncreaseRepeatButton>
                                        <RepeatButton Style="{StaticResource Nx.ScrollPage}" Command="ScrollBar.PageRightCommand" />
                                    </Track.IncreaseRepeatButton>
                                </Track>
                            </Grid>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Trigger>
        </Style.Triggers>
    </Style>

    <!-- ============================== Flutuantes ============================== -->
    <Style TargetType="ToolTip">
        <Setter Property="Background" Value="{DynamicResource Nx.Navy}" />
        <Setter Property="Foreground" Value="{DynamicResource Nx.OnNavy}" />
        <Setter Property="FontSize" Value="12" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ToolTip">
                    <Border Background="{TemplateBinding Background}" CornerRadius="6" Padding="10,6">
                        <ContentPresenter />
                    </Border>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- Separador "·" usado entre informações e links -->
    <Style x:Key="Nx.Sep" TargetType="TextBlock">
        <Setter Property="Text" Value="·" />
        <Setter Property="Margin" Value="8,0" />
        <Setter Property="Foreground" Value="{DynamicResource Nx.TextSubtle}" />
        <Setter Property="VerticalAlignment" Value="Center" />
    </Style>

    <!-- Cartão de escolha (RadioButton): borda azul quando escolhido. Conteúdo livre. -->
    <Style x:Key="Nx.ChoiceCard" TargetType="RadioButton">
        <Setter Property="FocusVisualStyle" Value="{StaticResource Nx.FocusVisual}" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="Foreground" Value="{DynamicResource Nx.Text}" />
        <Setter Property="Background" Value="{DynamicResource Nx.Surface}" />
        <Setter Property="BorderBrush" Value="{DynamicResource Nx.Border}" />
        <Setter Property="Padding" Value="20,18" />
        <Setter Property="HorizontalContentAlignment" Value="Stretch" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="RadioButton">
                    <Border x:Name="Card" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}"
                            BorderThickness="1.5" CornerRadius="{StaticResource Nx.Radius.Card}" Padding="{TemplateBinding Padding}">
                        <ContentPresenter HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}" />
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Card" Property="BorderBrush" Value="{DynamicResource Nx.BorderHover}" />
                        </Trigger>
                        <Trigger Property="IsChecked" Value="True">
                            <Setter TargetName="Card" Property="BorderBrush" Value="{DynamicResource Nx.Blue}" />
                            <Setter TargetName="Card" Property="Background" Value="{DynamicResource Nx.BlueSoft}" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- Código grande (pareamento) -->
    <Style x:Key="Nx.BigCode" TargetType="TextBlock">
        <Setter Property="FontFamily" Value="{DynamicResource Nx.Mono}" />
        <Setter Property="FontSize" Value="30" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="Foreground" Value="{DynamicResource Nx.Text}" />
        <Setter Property="HorizontalAlignment" Value="Center" />
    </Style>

    <!-- Linha de log: hora em cinza e texto colorido pelo nível (ok, aviso, erro) -->
    <DataTemplate x:Key="Nx.LogLineTemplate" DataType="{x:Type ui:LogLine}">
        <DockPanel Margin="0,0,0,2" LastChildFill="True">
            <TextBlock DockPanel.Dock="Left" Text="{Binding TimeText, Mode=OneWay}" Foreground="{DynamicResource Nx.Log.Dim}" Margin="0,0,12,0" />
            <TextBlock x:Name="Body" Text="{Binding Text, Mode=OneWay}" TextWrapping="Wrap" />
        </DockPanel>
        <DataTemplate.Triggers>
            <DataTrigger Binding="{Binding Level}" Value="Ok">
                <Setter TargetName="Body" Property="Foreground" Value="{DynamicResource Nx.Log.Ok}" />
            </DataTrigger>
            <DataTrigger Binding="{Binding Level}" Value="Warn">
                <Setter TargetName="Body" Property="Foreground" Value="{DynamicResource Nx.Log.Warn}" />
            </DataTrigger>
            <DataTrigger Binding="{Binding Level}" Value="Error">
                <Setter TargetName="Body" Property="Foreground" Value="{DynamicResource Nx.Log.Err}" />
            </DataTrigger>
            <DataTrigger Binding="{Binding Level}" Value="Dim">
                <Setter TargetName="Body" Property="Foreground" Value="{DynamicResource Nx.Log.Dim}" />
            </DataTrigger>
        </DataTemplate.Triggers>
    </DataTemplate>

</ResourceDictionary>
