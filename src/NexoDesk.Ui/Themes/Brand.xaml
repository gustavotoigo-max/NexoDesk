<!--
  Nexotool UI — cores de marca (iguais nos dois temas), fontes e degradê de destaque.
  Fonte: guia visual Nexotool UI v1.0 (tokens/nexotool.tokens.json).
-->
<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <Color x:Key="Nx.Color.Navy">#0B1733</Color>
    <Color x:Key="Nx.Color.Navy2">#132447</Color>
    <Color x:Key="Nx.Color.Navy3">#1E3260</Color>
    <Color x:Key="Nx.Color.BlueHover">#1D4ED8</Color>
    <Color x:Key="Nx.Color.BluePressed">#1E40AF</Color>
    <Color x:Key="Nx.Color.Cyan">#22D3EE</Color>
    <Color x:Key="Nx.Color.OnNavy">#F8FAFC</Color>
    <Color x:Key="Nx.Color.OnNavyMuted">#94A3B8</Color>
    <Color x:Key="Nx.Color.LogText">#E2E8F0</Color>
    <Color x:Key="Nx.Color.Close">#C42B1C</Color>

    <SolidColorBrush x:Key="Nx.Navy" Color="#0B1733" />
    <SolidColorBrush x:Key="Nx.Navy2" Color="#132447" />
    <SolidColorBrush x:Key="Nx.Navy3" Color="#1E3260" />
    <SolidColorBrush x:Key="Nx.BlueHover" Color="#1D4ED8" />
    <SolidColorBrush x:Key="Nx.BluePressed" Color="#1E40AF" />
    <SolidColorBrush x:Key="Nx.Cyan" Color="#22D3EE" />
    <SolidColorBrush x:Key="Nx.OnNavy" Color="#F8FAFC" />
    <SolidColorBrush x:Key="Nx.OnNavyMuted" Color="#94A3B8" />
    <SolidColorBrush x:Key="Nx.LogText" Color="#E2E8F0" />
    <SolidColorBrush x:Key="Nx.Close" Color="#C42B1C" />
    <SolidColorBrush x:Key="Nx.White" Color="#FFFFFF" />

    <!-- Cores do log (fundo azul-marinho) -->
    <SolidColorBrush x:Key="Nx.Log.Ok" Color="#86EFAC" />
    <SolidColorBrush x:Key="Nx.Log.Warn" Color="#FCD34D" />
    <SolidColorBrush x:Key="Nx.Log.Err" Color="#FCA5A5" />
    <SolidColorBrush x:Key="Nx.Log.Dim" Color="#94A3B8" />

    <!-- Linha de destaque: degradê azul → ciano, da esquerda para a direita -->
    <LinearGradientBrush x:Key="Nx.AccentGradient" StartPoint="0,0.5" EndPoint="1,0.5">
        <GradientStop Offset="0" Color="#2563EB" />
        <GradientStop Offset="1" Color="#22D3EE" />
    </LinearGradientBrush>

    <FontFamily x:Key="Nx.Font">Segoe UI Variable Text, Segoe UI</FontFamily>
    <FontFamily x:Key="Nx.Mono">Cascadia Mono, Consolas</FontFamily>
    <FontFamily x:Key="Nx.Icons">Segoe Fluent Icons, Segoe MDL2 Assets</FontFamily>

</ResourceDictionary>
